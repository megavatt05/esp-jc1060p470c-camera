# Целевой чип ESP32-P4
CONFIG_IDF_TARGET="esp32p4"

# Флеш 16 МБ QIO 80 МГц и кастомная таблица разделов (App 4 МБ)
# Таблица разделов на 0x10000: загрузчик P4 в IDF 6 занимает ~24 КБ и впрок
# в 0x2000..0x8000 уже не влезает. Тот же расклад, что в других ветках.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# Обязательные флаги для ESP32-P4 rev 1.0 / 1.3 (Guition JC1060P470C)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# 400 МГц этот кристалл не тянет: только 360
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360

# PSRAM 32 МБ @ 200 МГц
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n

# Производительность и стек
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_FREERTOS_HZ=1000

# Поддержка микросхем флеш Boya / GD (установлены на JC1060P470C)
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y

# LVGL 9 конфигурация
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_FONT_COMPRESSED=n
CONFIG_LV_FONT_DEJAVU_16_PERSIAN_HEBREW=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y

# ---- Станок намотки PON ----
# Линия 485 встроена в плату (MAX485 U8, автоматическое направление):
# TX=GPIO26, RX=GPIO27, DE не используется.
CONFIG_STANOK_RS485_DE_GPIO=-1
CONFIG_STANOK_RS485_AUTO_PINS=y
CONFIG_STANOK_RS485_PIN_SCAN=y
# ИДМ-20 по требованию пока не подключается
CONFIG_STANOK_USE_IDM20=n
