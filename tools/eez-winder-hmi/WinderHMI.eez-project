        },
        {
          "objID": "502d13e9-060d-5f7b-be38-6fda2a7d0068",
          "fileName": "styles.c",
          "template": "#include \"styles.h\"\r\n#include \"images.h\"\r\n#include \"fonts.h\"\r\n\r\n//${eez-studio LVGL_STYLES_DEF}"
        },
        {
          "objID": "0840bc0f-e17c-530a-88c6-898a0dddbcb9",
          "fileName": "ui.h",
          "template": "#ifndef EEZ_LVGL_UI_GUI_H\r\n#define EEZ_LVGL_UI_GUI_H\r\n\r\n//${eez-studio LVGL_INCLUDE}\r\n\r\n#include \"screens.h\"\r\n\r\n#ifdef __cplusplus\r\nextern \"C\" {\r\n#endif\r\n\r\nvoid ui_init();\r\nvoid ui_tick();\r\n\r\nvoid loadScreen(enum ScreensEnum screenId);\r\n\r\n#ifdef __cplusplus\r\n}\r\n#endif\r\n\r\n#endif // EEZ_LVGL_UI_GUI_H"
        },
        {
          "objID": "1be1b103-27cc-5d55-a304-e1755587aaff",
          "fileName": "ui.c",
          "template": "#include \"ui.h\"\r\n#include \"images.h\"\r\n\r\nstatic int16_t currentScreen = -1;\r\n\r\nstatic lv_obj_t *getLvglObjectFromIndex(int32_t index) {\r\n    if (index == -1) {\r\n        return 0;\r\n    }\r\n    return ((lv_obj_t **)&objects)[index];\r\n}\r\n\r\nvoid loadScreen(enum ScreensEnum screenId) {\r\n    currentScreen = (int16_t)(screenId - 1);\r\n    lv_obj_t *screen = getLvglObjectFromIndex(currentScreen);\r\n    lv_screen_load_anim(screen, LV_SCREEN_LOAD_ANIM_FADE_ON, 150, 0, false);\r\n}\r\n\r\nvoid ui_init() {\r\n    create_screens();\r\n    loadScreen(SCREEN_ID_MAIN);\r\n}\r\n\r\nvoid ui_tick() {\r\n    tick_screen(currentScreen);\r\n}"
        }
      ],
